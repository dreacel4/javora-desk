# ---------------------------------------------------------------------------
# JAVORA DESK — environment variables
# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables. NEVER commit real values.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings → API / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public client key. Use the "publishable" key (sb_publishable_…).
# Projects that still use legacy keys can instead set NEXT_PUBLIC_SUPABASE_ANON_KEY.
# This key is safe in the browser: every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY secret key (sb_secret_…), legacy name: SUPABASE_SERVICE_ROLE_KEY.
# Bypasses RLS. Used only for: sending invitations, banning disabled accounts,
# and the one-time first-owner script. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this deployment, no trailing slash. Used in invitation and
# password-reset links. On Vercel it falls back to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
